{
  "name": "graverse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts",
    "validate:echoes": "tsx scripts/validate-echoes.ts",
    "test:data": "tsx --test tests/data.test.ts",
    "test:echoes": "tsx --test tests/echoes.test.ts tests/cinematic.test.ts",
    "test:ask": "tsx --test tests/ask.test.ts tests/ask-local.test.ts tests/ask-markdown.test.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "test:journeys": "node scripts/journeys.mjs",
    "test:links": "node scripts/link-check.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:mobile": "node scripts/perf-mobile.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "4.10.2",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.169.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "puppeteer-core": "23.11.1",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
