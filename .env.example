# Public origin used for canonical URLs, Open Graph metadata and sitemap links.
# Leave unset locally; the layout falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: path to a Chrome/Chromium executable for `npm run test:e2e` and
# `npm run perf`. If omitted the scripts probe common macOS/Linux locations.
# CHROME_PATH=/usr/bin/google-chrome

# Optional: override the Next.js build directory. The verify script uses
# `.next-prod` so browser checks never touch a running dev cache.
# GRAVERSE_DIST_DIR=.next-prod

# Optional: the port `npm run verify` serves the production build on.
# Defaults to 3100. Change it when that port is already in use.
# GRAVERSE_VERIFY_PORT=3100

# ---------------------------------------------------------------------------
# Ask GRAVERSE — the OpenRouter-backed assistant
#
# Both variables are optional. Without an API key the rest of GRAVERSE works
# exactly as before and the assistant reports that it is not configured.
#
# The key is server-side only. It is read inside the Next.js route handler,
# is never sent to the browser, and is never written to a client bundle.
# Never rename it to a NEXT_PUBLIC_ variable and never commit it.
#
# Put the real key in `.env.local`, which is git-ignored. This file is tracked
# and must always keep an empty value.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# The model the assistant calls. `openrouter/free` is OpenRouter's free-model
# router: it always resolves to a free model and never to a paid one.
#
# You may pin a specific free variant instead — the identifier must end in
# `:free`, for example `google/gemma-4-31b-it:free`. Any other value is
# rejected before a request is made, so a paid model can never be reached.
OPENROUTER_MODEL=openrouter/free
