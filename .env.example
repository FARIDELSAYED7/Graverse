# Public origin used for canonical URLs, Open Graph metadata and sitemap links.
# Leave unset locally; the layout falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: path to a Chrome/Chromium executable for `npm run test:e2e` and
# `npm run perf`. If omitted the scripts probe common macOS/Linux locations.
# CHROME_PATH=/usr/bin/google-chrome

# Optional: override the Next.js build directory. The verify script uses
# `.next-prod` so browser checks never touch a running dev cache.
# GRAVERSE_DIST_DIR=.next-prod
